{
  "name": "inventory-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "test": "jest",
    "build:styles": "npx tailwindcss -i src/styles.scss -o src/styles.css --content \"./src/**/*.{html,ts}\"",
    "start": "npm run build:styles && ng serve",
    "build": "npm run build:styles && ng build",
    "watch": "npm run build:styles && ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@azure/msal-angular": "^5.3.1",
    "@azure/msal-browser": "^5.22.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jest": "^29.5.14",
    "angular-eslint": "^19.8.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.70.1"
  }
}
