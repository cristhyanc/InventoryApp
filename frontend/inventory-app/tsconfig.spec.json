{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "commonjs",
    "moduleResolution": "node",
    // The design-token contrast spec reads the real token values out of tailwind.config.js, so
    // Jest has to be allowed to compile that CommonJS file. Type checking of JavaScript stays
    // off (`checkJs` is not set); this only lets a spec import one.
    "allowJs": true,
    "types": ["jest", "node"]
  },
  // `*.spec-helpers.ts` holds doubles and shared suites several specs use; it is test-only, and
  // the application build (tsconfig.app.json) never compiles it.
  "include": ["src/**/*.spec.ts", "src/**/*.spec-helpers.ts", "src/**/*.d.ts", "tailwind.config.js"]
}
