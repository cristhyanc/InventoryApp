<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <!-- Reading an uploaded Nayax transaction export (issue #301) and writing report XLSX exports
         (issue #306, which removed the last InventoryApi reference). Both stay behind Application
         ports - Inventory.Application.Imports.INayaxSalesWorkbookReader and
         Inventory.Application.Reporting.Export.IReportExportFileWriter; ClosedXML types must never
         reach Inventory.Application or Inventory.Domain, which CleanArchitectureDependencyTests
         enforces. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- EF Core ownership moved here with AppDbContext, the EF entities and the EF migrations
         (issue #307). Relational is what the generated migrations and the model snapshot compile
         against (MigrationBuilder, table/column/index operations). The SQLite provider is
         deliberately NOT referenced here: choosing a provider and a connection string is a
         composition-root decision, so Microsoft.EntityFrameworkCore.Sqlite (and the Design package
         the `dotnet ef` tooling needs) stay in InventoryApi. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <!-- The platform diagnostics read path (issue #336) enforces its boundary inside SQLite
         itself - a read-only connection, PRAGMA query_only, a zero SQLITE_LIMIT_ATTACHED and an
         authorizer callback consulted during statement preparation - so it needs the ADO.NET
         driver (Microsoft.Data.Sqlite.Core) and the raw API that exposes the authorizer, the
         progress handler and sqlite3_interrupt (SQLitePCLRaw.core). This is deliberately NOT the
         EF Core SQLite provider: choosing an EF provider and a connection string remains the
         composition root's decision, and InventoryApi still owns
         Microsoft.EntityFrameworkCore.Sqlite and the native SQLitePCLRaw.lib.e_sqlite3 bundle.
         Both packages here are .Core variants, so no second native library is bundled. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Polly.Core" Version="8.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Domain\Inventory.Domain.csproj" />
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
  </ItemGroup>

</Project>
