{
  // Development raises the framework categories appsettings.json keeps at Warning back to
  // Information (issue #165). Nothing is exported or retained locally - no Application Insights
  // connection string is configured - so the per-request and per-query detail is free here and
  // genuinely useful, while the deployed levels stay quiet and cheap.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.Identity.Web": "Information"
    }
  }
}
