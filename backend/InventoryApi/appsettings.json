{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=inventory.db"
  },
  // Logging levels (issue #165). These are the deployed/production levels: every log that passes
  // them is exported to Application Insights and retained, so the policy is "every application
  // warning and error, and nothing a framework emits per request".
  //
  //   Default                                      application code (InventoryApi.*,
  //                                                Inventory.Application.*, ...) at Information
  //   Microsoft / Microsoft.AspNetCore             framework noise, warnings and errors only
  //   Microsoft.Hosting.Lifetime                   kept at Information: start/stop and the bound
  //                                                URLs are the record that a deployment came up
  //   Microsoft.EntityFrameworkCore                warnings and errors only, which suppresses the
  //   Microsoft.EntityFrameworkCore.Database.Command   per-query SQL command log - by far the
  //                                                noisiest and most expensive category, and the
  //                                                one most likely to carry business data
  //   Microsoft.EntityFrameworkCore.Migrations     kept at Information: normal Production startup
  //                                                applies pending migrations (issue #201), so
  //                                                "Applying migration ..." is an audit record
  //   Azure / System.Net.Http                      SDK and HttpClient chatter, warnings and
  //                                                errors only; this also keeps the telemetry
  //                                                exporter's own Information logs from feeding
  //                                                themselves back into the exporter
  //
  // appsettings.Development.json raises the framework, EF command and Identity.Web categories back
  // to Information for local debugging, where nothing is exported or retained.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information",
      "Microsoft.Identity.Web": "Warning",
      "System.Net.Http": "Warning",
      "Azure": "Warning"
    }
  },
  // Nayax Lynx HTTP client (issue #49). BaseUrl is non-secret, global and validated at startup;
  // use https://qa-lynx.nayax.com for the QA sandbox. Since issue #520 the operator id and the
  // access token are each business's own, read per call from its encrypted connection record, so
  // OperatorId here is no longer used by the client and startup no longer requires it: it remains
  // only as the value the human-run migrate-nayax-connection command moves into the business, and
  // a human removes it afterwards (docs/tenant-rollout.md). The token is a secret and is never
  // committed here - see Inventory.Infrastructure.Nayax.NayaxLynxConfiguration and
  // README.md § Configuration and secrets.
  "NayaxLynx": {
    "BaseUrl": "https://lynx.nayax.com",
    "OperatorId": "2002736764"
  },
  // Encryption of each business's own stored Nayax access token (issue #518). Intentionally empty
  // in source control: every value here is secret key material and must never be committed. Empty
  // means no key is configured, which is the shipped state - the API starts and runs normally, and
  // only storing or reading a per-business Nayax token fails closed until a human provisions a key.
  // Supply it per environment with `dotnet user-secrets` locally or Key Vault/App Service
  // configuration in Azure:
  //   NayaxTokenProtection__ActiveKeyId=<key-id>
  //   NayaxTokenProtection__Keys__<key-id>=<base64 256-bit key>
  // The key id is stored beside each ciphertext, so a rotation adds a new key and repoints
  // ActiveKeyId while the previous key stays configured until nothing names it any more. See
  // README.md § Configuration and secrets.
  "NayaxTokenProtection": {
    "ActiveKeyId": "",
    "Keys": {}
  },
  "AllowedHosts": "*",
  // Uploaded business documents (issue #39). FileSystem keeps them under
  // {ContentRoot}/protected-files, which is what every environment ran before this setting
  // existed. An environment moves to the private Azure container by overriding:
  //   DocumentStorage__Provider=AzureBlob
  //   DocumentStorage__BlobServiceUri=https://<storage-account>.blob.core.windows.net
  //   DocumentStorage__ContainerName=business-documents        (business-documents-dev locally)
  // Nothing here is or may become a secret: the adapter authenticates with a managed identity
  // through DefaultAzureCredential, so there is no account key, SAS token or connection string.
  "DocumentStorage": {
    "Provider": "FileSystem"
  },
  // Tenant ownership bootstrap (issue #64). Intentionally empty in source control: ObjectId is
  // a real person's Entra identifier and must never be committed. Supply the real values per
  // environment with `dotnet user-secrets` locally or application settings in Azure, then run
  // `bootstrap-business` by hand. See docs/tenant-rollout.md. With this section empty the
  // bootstrap refuses to run rather than inventing an identity.
  "BusinessBootstrap": {
    "BusinessName": "",
    "Members": []
  },
  // Platform diagnostics super-admin (issue #336). Intentionally empty in source control, for the
  // same reason BusinessBootstrap above is: these are a real person's Entra identifiers and must
  // never be committed. Empty means nobody is a platform administrator and
  // /api/admin/diagnostics/* refuses every caller, including business members - that is the
  // shipped, fail-closed state. Supply the pair per environment with `dotnet user-secrets`
  // locally or application settings in Azure (PlatformAdmin__DirectoryTenantId,
  // PlatformAdmin__ObjectId). Neither value is a secret - an Entra object id is an identifier that
  // grants nothing without a validated token carrying it - so no Key Vault reference is needed.
  // See README.md § Platform diagnostics API and docs/architecture.md § Platform diagnostics.
  "PlatformAdmin": {
    "DirectoryTenantId": "",
    "ObjectId": ""
  },
  // Self-service business onboarding (issue #541). False is the shipped state and the only one
  // source control carries: with it off, POST /api/onboarding/business-applications answers 404 and
  // GET /api/me/account-state reports onboardingEnabled: false, so nobody can create a tenant in a
  // deployment that has not deliberately opened the door. It is declared here rather than left
  // absent so the setting is discoverable; absent means exactly the same thing, because an absent,
  // blank or unparseable value is read as off.
  //
  // Switching it on in production is a human decision with a release gate in front of it - the
  // #500 migration command run in production, and #329's required changes deployed to production
  // and verified there by a human. See docs/tenant-rollout.md § Enabling self-service onboarding.
  "SelfServiceOnboarding": {
    "Enabled": false
  },
  // Business plan enforcement (issue #966, decided 29 Oct 2026 on #965). False is the shipped state
  // and the only one source control carries: with it off every business is unrestricted and behaves
  // exactly as it did before plans existed, and GET /api/me/access reports that nothing is enforced.
  // It is declared here rather than left absent so the setting is discoverable; absent means exactly
  // the same thing, because an absent, blank or unparseable value is read as off.
  //
  // Switching it on is a human decision with a release gate in front of it (#965 § Launch gate), and
  // the `grandfather-business-plans` command must have completed first - otherwise the API logs a
  // startup error and keeps treating every business as unrestricted. See README.md § Business plans
  // and docs/architecture.md § Business subscriptions and plan entitlements.
  "Subscriptions": {
    "EnforcementEnabled": false
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "3dd61784-7289-4c2d-b0aa-3bb586a92004",
    "Scopes": "access_as_user"
  },
  // Customer identity through Microsoft Entra External ID (issue #710, design
  // docs/identity-provider-decision.md § 5.3). The three identifiers are intentionally empty in
  // source control, exactly as PlatformAdmin and BusinessBootstrap are: empty is the shipped,
  // fail-closed state and means this API trusts no customer identity tenant at all - the second
  // bearer scheme is not registered, every External ID token is 401, and workforce Microsoft
  // sign-in above is untouched. A half-filled or malformed section means the same thing and is
  // logged as a startup error.
  //
  // Nothing here is a secret: the API validates tokens with the authority's published signing keys
  // and the SPA is a public client using authorization code with PKCE, so neither holds a client
  // secret. These are ordinary App Service application settings - no Key Vault reference needed -
  // and no real identifier may be committed here:
  //   ExternalId__Instance=https://<tenant-subdomain>.ciamlogin.com/
  //   ExternalId__TenantId=<external-id-tenant-guid>
  //   ExternalId__ClientId=<api-app-registration-guid in that tenant>
  // ClientId is a different registration from AzureAd:ClientId above, because an app registration
  // belongs to one tenant and each scheme validates only its own audience. Scopes is recorded for
  // discoverability only; the required scope is enforced by [RequiredScope("access_as_user")] on
  // every controller. See README.md § Authentication configuration and docs/architecture.md
  // § Authentication and authorization.
  "ExternalId": {
    "Instance": "",
    "TenantId": "",
    "ClientId": "",
    "Scopes": "access_as_user"
  },
  // The scheduled price collector (issue #924, parent #817). The two identifiers are intentionally
  // empty in source control, exactly as PlatformAdmin and ExternalId above are: empty is the
  // shipped, fail-closed state and means this API trusts no collector at all - the collector bearer
  // scheme accepts nothing, the collector policy denies everybody, and GET
  // /api/price-collector/work is 401 for every request. A half-filled or malformed section means
  // the same thing and is logged as a startup error.
  //
  // Nothing here is a secret: the collector obtains a short-lived Microsoft Entra token through
  // GitHub OIDC workload identity federation, so there is no Restockroo password and no client
  // secret on either side. These are ordinary App Service application settings - no Key Vault
  // reference needed - and no real identifier may be committed here:
  //   PriceCollector__TenantId=<owner-tenant-guid>
  //   PriceCollector__ClientId=<collector-app-registration-guid in that tenant>
  // The workforce scheme above is multi-tenant, so another tenant could consent to this API and
  // assign the PriceCollector.Run app role to an app of its own: pinning both the tenant and the
  // calling application is mandatory, not defence in depth.
  //
  // RunExpiryHours is how long an issued run stays open unless the collector reports back. Blank,
  // unparseable or out of range means the owner's default of 6 hours; it is never read as "no
  // expiry". See README.md § The scheduled price collector and docs/architecture.md § The price
  // collector's app-only path.
  "PriceCollector": {
    "TenantId": "",
    "ClientId": "",
    "RunExpiryHours": ""
  }
}
