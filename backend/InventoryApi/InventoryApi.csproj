<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>6fa5702c-e297-4f69-8671-5e59306e64b2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft-supported Azure Monitor OpenTelemetry distribution (issue #165). It is the only
         telemetry pipeline: the classic Microsoft.ApplicationInsights.AspNetCore SDK must never be
         added alongside it, which TelemetryCompositionTests enforces. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.15.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="[2.1.12-pre20260709125052, )" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\expenses\" />
    <Folder Include="wwwroot\ImportedFiles\" />
    <Folder Include="wwwroot\receipts\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scheduled database backup WebJob (issue #333). App Service reads a triggered WebJob from
         App_Data/jobs/triggered/<job name>/ under the deployed site root, which is this project's
         publish output - so the job ships with the API in the artifact Deploy Production already
         deploys whole, and no workflow change is needed. The Web SDK's default content globs cover
         wwwroot, *.config and *.json only, so run.sh and settings.job have to be declared here or
         publish would silently leave the schedule behind.
         App_Data is not under wwwroot and is never served as static content.
         BackupWebJobPackagingTests asserts this declaration, the schedule and the invocation. -->
    <Content Include="App_Data\jobs\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
    <ProjectReference Include="..\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
