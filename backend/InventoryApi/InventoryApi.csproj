<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>6fa5702c-e297-4f69-8671-5e59306e64b2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft-supported Azure Monitor OpenTelemetry distribution (issue #165). It is the only
         telemetry pipeline: the classic Microsoft.ApplicationInsights.AspNetCore SDK must never be
         added alongside it, which TelemetryCompositionTests enforces. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <!-- No ClosedXML here: issue #301 moved the workbook reader and issue #306 the report export
         writer into Inventory.Infrastructure, which owns the only reference now. A spreadsheet
         format is an adapter detail, so new XLSX code belongs there behind an Application port. -->
    <!-- Issue #307 moved AppDbContext, the EF entities and the migrations into
         Inventory.Infrastructure, which now owns the EntityFrameworkCore/Relational references. What
         stays here is the composition root's job: the SQLite provider and the one UseSqlite call
         that reads ConnectionStrings:DefaultConnection, and the Design package the `dotnet ef`
         tooling needs when InventoryApi is the startup project. EntityFrameworkCore itself is
         still a direct reference because Program.cs calls AddDbContext and the temporary
         Adapters/Persistence family uses the EF query extension methods. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.15.0" />
    <!-- The native SQLite engine this application deploys (issue #1290), and the only SQLitePCLRaw
         package InventoryApi names. The reference is direct because the engine version is a
         deployment decision and this project's publish output is what carries it: the native library
         ships as runtimes/<rid>/native/[lib]e_sqlite3.* beside the managed assemblies. Without a
         direct reference the version would be whatever Microsoft.Data.Sqlite's bundle package
         happens to bring, which is not something a database this application owns should inherit
         silently. 2.1.13 is deliberately the version SQLitePCLRaw.bundle_e_sqlite3 (via
         Microsoft.Data.Sqlite 10.0.15) already resolves to, so core, bundle_e_sqlite3,
         provider.e_sqlite3 and this package all land on one stable version with no further pins;
         its bundled native SQLite is 3.53.3, the same engine the prerelease range this replaced
         ([2.1.12-pre20260709125052, )) resolved to. Keep it an exact stable version - never a range
         and never a prerelease - and keep SQLitePCLRaw.core in Inventory.Infrastructure in step
         with it. NativeSqliteLibraryTests holds the engine-version floor. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <!-- Transitive security pin: the package graph otherwise resolves 10.0.10, which has high-severity
         advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once a direct dependency
         brings a patched version itself. Still required at 10.0.15 (issue #1290): restoring without
         this pin fails with NU1903/NU1902 on 10.0.10. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\expenses\" />
    <Folder Include="wwwroot\ImportedFiles\" />
    <Folder Include="wwwroot\receipts\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scheduled database backup WebJob (issue #333). App Service reads a triggered WebJob from
         App_Data/jobs/triggered/<job name>/ under the deployed site root, which is this project's
         publish output - so the job ships with the API in the artifact Deploy Production already
         deploys whole, and no workflow change is needed. The Web SDK's default content globs cover
         wwwroot, *.config and *.json only, so run.sh and settings.job have to be declared here or
         publish would silently leave the schedule behind.
         App_Data is not under wwwroot and is never served as static content.
         BackupWebJobPackagingTests asserts this declaration, the schedule and the invocation. -->
    <Content Include="App_Data\jobs\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
    <ProjectReference Include="..\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Issue #1308 (audit OPS-04, #1228/#1231): stamp the build's git commit into SourceRevisionId
       so the SDK appends it to AssemblyInformationalVersionAttribute as "+<sha>" (see
       IncludeSourceRevisionInInformationalVersion, on by default) with no SourceLink package and
       no change to the `dotnet publish` command or a workflow. BuildMetadata reads it at startup
       for the health endpoints' X-Build-Sha header. A build with no git checkout (git missing or
       ".git" absent) leaves SourceRevisionId unset; BuildMetadata then reports "unknown". -->
  <Target Name="Issue1308SetSourceRevisionId" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="Issue1308GitHead" />
      <Output TaskParameter="ExitCode" PropertyName="Issue1308GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(Issue1308GitExitCode)' == '0' And '$(Issue1308GitHead.Trim())' != ''">
      <SourceRevisionId>$(Issue1308GitHead.Trim())</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
